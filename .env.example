# DATABASE
# Recommended local dev path: docker-compose Postgres
DB_USER="ori"
# Production: at least 32 random URL-safe characters (letters, digits, . _ ~ -).
DB_PASSWORD="change-this-password"
DB_NAME="ori_cruit_hub"
DATABASE_URL="postgresql://ori:change-this-password@localhost:5432/ori_cruit_hub?schema=public"

# Alternative if you use the Windows Postgres service on this machine:
# DATABASE_URL="postgresql://your-user:your-password@localhost:5433/ori_cruit_hub?schema=public"

# AUTH
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-auth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-auth-secret-min-32-chars"

# SUPABASE (STORAGE)
STORAGE_PROVIDER="supabase"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="documentos-candidatos"

# LOCAL STORAGE FALLBACK (VPS / NO SUPABASE)
# Use this to keep document uploads alive when Supabase Storage is unavailable.
# STORAGE_PROVIDER="local"
# Local file storage must stay outside Next.js public assets.
# LOCAL_STORAGE_DIR="/app/private-uploads"

# OCR
# Recommended default: OCR_PROVIDER="tesseract"
# OCR_PROVIDER="manual" disables automatic extraction and keeps documents ready for manual review.
OCR_PROVIDER="tesseract"
AZURE_DI_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_DI_KEY="your-azure-key"

# EMAIL DELIVERY (SMTP)
# Without these values, invitations are created but shown with a manual temporary password.
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="no-reply@your-domain.com"
SMTP_FROM_NAME="ORI CRUIT HUB"
# Only use true for trusted local test SMTP servers without STARTTLS.
SMTP_ALLOW_INSECURE="false"

# LOCAL/PRODUCTION MODE
NODE_ENV="development"
JOB_PROVIDER="inline"
CRON_SECRET="your-random-cron-secret-min-32-chars"
APP_RELEASE="local-dev"
# Optional for full hardening checks with a real outbound SMTP delivery test.
SMTP_TEST_RECIPIENT=""

# HOSTINGER PRODUCTION NOTES
# On the VPS, keep DATABASE_URL managed by docker-compose.prod.yml.
# Set AUTH_URL and NEXTAUTH_URL to your HTTPS domain.
# Set SMTP_* to real provider values before inviting users.
# For production only, set WEB_IMAGE and APP_RELEASE together from the same
# successful main-branch Quality workflow release.env artifact. WEB_IMAGE must
# be a GHCR sha256 digest reference; never use a moving tag for deployment.
# WEB_IMAGE="ghcr.io/ib4d/folga-intermediario-hub@sha256:<digest>"

# STRIPE (OPTIONAL UNTIL DISTRIBUTION PHASE)
# Keep STRIPE_SECRET_KEY and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY in the same mode.
# Use STRIPE_WEBHOOK_SECRET from a webhook endpoint created in that same mode.
# Required whenever STRIPE_SECRET_KEY is configured; runtime fails closed if absent or mismatched.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_EXPECTED_MODE=""
STRIPE_CUSTOMER_PORTAL_ENABLED="false"
STRIPE_PAYMENT_LINK_STARTER=""
STRIPE_PAYMENT_LINK_PRO=""
STRIPE_PAYMENT_LINK_BUSINESS=""
STRIPE_PAYMENT_LINK_ENTERPRISE=""

# Optional seed controls. In production, demo seeding is blocked unless explicitly enabled.
ALLOW_DEMO_SEED="false"
SEED_ADMIN_EMAIL="admin@your-domain.com"
SEED_LEGAL_EMAIL="legal@your-domain.com"
SEED_INTERMEDIARY_EMAIL="intermediary@your-domain.com"
SEED_ADMIN_PASSWORD="replace-with-a-long-random-password"
